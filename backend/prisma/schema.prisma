generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  AGENT
}

enum BuyerStatus {
  ACTIVE
  INACTIVE
}

enum ConfigStatus {
  ENABLED
  DISABLED
}

enum HttpMethod {
  GET
  POST
}

enum LeadStatus {
  SUBMITTED
  SOLD
  REJECTED
}

enum PingStatus {
  PENDING
  RESERVED
  REJECTED
  ERROR
}

enum CrmStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(AGENT)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  leads        Lead[]
  crmEntries   CrmEntry[]
  apiLogs      ApiLog[]

  @@index([role])
}

model Campaign {
  id          String   @id @default(cuid())
  name        String   @unique
  vertical    String
  description String   @default("")
  active      Boolean  @default(true)
  defaults    Json     @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  configs     RtbConfig[]
  leads       Lead[]
  crmEntries  CrmEntry[]
}

model Buyer {
  id        String      @id @default(cuid())
  name      String
  company   String      @default("")
  provider  String
  priority  Int         @default(100)
  weight    Int         @default(100)
  status    BuyerStatus @default(ACTIVE)
  notes     String      @default("")
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  configs   RtbConfig[]
  pings     Ping[]

  @@index([priority])
  @@index([status])
}

model RtbConfig {
  id         String       @id @default(cuid())
  name       String
  buyerId    String
  buyer      Buyer        @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  campaignId String?
  campaign   Campaign?    @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  provider   String
  method     HttpMethod   @default(GET)
  mode       String       @default("RTB")
  status     ConfigStatus @default(ENABLED)
  baseUrl    String       @default("")
  apiKey     String       @default("")
  params     Json         @default("[]")
  staticParams Json       @default("{}")
  headers    Json         @default("{}")
  extra      Json         @default("{}")
  successCount Int        @default(0)
  totalCount   Int        @default(0)
  lastTestedAt DateTime?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  pings      Ping[]

  @@index([buyerId])
  @@index([campaignId])
  @@index([provider])
}

model Lead {
  id         String     @id @default(cuid())
  phone      String
  zip        String
  state      String
  campaignId String?
  campaign   Campaign?  @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  agentId    String
  agent      User       @relation(fields: [agentId], references: [id])
  buyerId    String?
  revenue    Decimal    @default(0) @db.Decimal(10, 2)
  score      Int        @default(0)
  status     LeadStatus @default(SUBMITTED)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  pings      Ping[]

  @@index([agentId])
  @@index([phone])
  @@index([createdAt])
  @@index([status])
}

model Ping {
  id           String     @id @default(cuid())
  leadId       String
  lead         Lead       @relation(fields: [leadId], references: [id], onDelete: Cascade)
  buyerId      String?
  buyer        Buyer?     @relation(fields: [buyerId], references: [id], onDelete: SetNull)
  configId     String?
  config       RtbConfig? @relation(fields: [configId], references: [id], onDelete: SetNull)
  agentId      String
  status       PingStatus @default(PENDING)
  bid          Decimal?   @db.Decimal(10, 2)
  trackingNumber String?
  rejectReason String?
  requestUrl   String     @default("")
  requestBody  Json?
  responseBody Json?
  httpStatus   Int?
  durationMs   Int?
  createdAt    DateTime   @default(now())

  @@index([leadId])
  @@index([agentId])
  @@index([createdAt])
}

model CrmEntry {
  id             String    @id @default(cuid())
  fronterName    String
  customerName   String
  customerNumber String
  customerZip    String
  customerEmail  String    @default("")
  did            String    @default("")
  campaignId     String?
  campaign       Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  comment        String    @default("")
  status         CrmStatus @default(PENDING)
  agentId        String
  agent          User      @relation(fields: [agentId], references: [id])
  reviewedById   String?
  reviewedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([agentId])
  @@index([status])
  @@index([createdAt])
}

model ApiLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  method     String
  path       String
  statusCode Int
  durationMs Int
  ip         String   @default("")
  createdAt  DateTime @default(now())

  @@index([createdAt])
}
