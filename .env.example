# ==============================================================
# RTB Enterprise Platform - Environment Configuration Template
# ==============================================================

# Node Environment ('production' or 'development')
NODE_ENV=production

# Database Credentials (PostgreSQL)
POSTGRES_USER=rtb_user
POSTGRES_PASSWORD=replace_with_strong_password_on_vps
POSTGRES_DB=rtb_prod

# Full connection string for backend (in Docker Compose, host is 'db')
DATABASE_URL=postgresql://rtb_user:replace_with_strong_password_on_vps@db:5432/rtb_prod?schema=public

# Application Secrets
JWT_SECRET=replace_with_random_64_character_hex_secret
JWT_EXPIRES_IN=24h

# Port Configuration
FRONTEND_PORT=80
PORT=4000

# CORS & Domain Settings
CORS_ORIGIN=http://your-vps-ip-or-domain.com

# Initial Seeding Credentials (created automatically on first boot)
SEED_ADMIN_EMAIL=admin@rtb.local
SEED_ADMIN_PASSWORD=admin12345
SEED_AGENT_PASSWORD=agent12345
